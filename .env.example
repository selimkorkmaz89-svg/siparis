# ---------------------------------------------------------------------------
# Bu dosya SUNUCU (Docker) kurulumu içindir: `cp .env.example .env`
#
# YEREL GELİŞTİRME İÇİN .env DOSYASINA İHTİYACINIZ YOK.
# Dosya yokken sistem SQLite ile çalışır, Postgres/Redis gerekmez.
#
# Docker'a özel ayarlar (veritabanı sunucu adı, Redis adresleri) burada değil,
# docker-compose.yml içinde tanımlıdır; böylece bu dosyayı yerelde kopyalamak
# hiçbir şeyi bozmaz.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=siparis.example.com
CSRF_TRUSTED_ORIGINS=https://siparis.example.com
LANGUAGE_CODE=tr
TIME_ZONE=Europe/Istanbul

# --- Database -------------------------------------------------------------
# Bu üç değer hem Postgres kabını hem uygulamayı besler.
POSTGRES_DB=siparis
POSTGRES_USER=siparis
POSTGRES_PASSWORD=change-me

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Siparis <noreply@example.com>

# --- Company identity (used on the order form PDF) ------------------------
COMPANY_NAME=BASH Medikal
COMPANY_TAX_NO=1234567890
COMPANY_ADDRESS=Örnek Mah. Örnek Cad. No:1, İstanbul
COMPANY_PHONE=+90 212 000 00 00
COMPANY_EMAIL=info@example.com
COMPANY_LOGO=img/logo.svg
ORDER_NO_PREFIX=BSH

# Payment/order mismatch tolerance (2% by default) - warns, never blocks.
PAYMENT_MISMATCH_TOLERANCE=0.02
